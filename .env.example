# ---------------------------------------------------------------------------
# Database (Supabase Postgres via Prisma)
# ---------------------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string
# Use the "Transaction" pooler (port 6543) for DATABASE_URL and the direct
# connection (port 5432) for DIRECT_URL (needed for migrations).
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase (Auth + Storage)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ---------------------------------------------------------------------------
# Razorpay
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ---------------------------------------------------------------------------
# Resend (transactional email)
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_xxxx"
RESEND_FROM_EMAIL="orders@shreemeenakshisweets.com"

# ---------------------------------------------------------------------------
# Twilio (WhatsApp order notifications) — optional, feature no-ops without it
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="ACxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_FROM="+14155238886"

# ---------------------------------------------------------------------------
# Twilio (Phone OTP login — Supabase Auth "Phone" provider)
# ---------------------------------------------------------------------------
# Reference only — this app never reads these. Supabase's own Auth server
# sends the SMS, so these three values are entered directly in the Supabase
# Dashboard (Authentication -> Sign In / Providers -> Phone -> enable ->
# Twilio), not here and not in Vercel. Kept here purely so every credential
# this project uses lives in one place.
#
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN can be the same Twilio account as
# the WhatsApp integration above. TWILIO_MESSAGE_SERVICE_SID is different
# from TWILIO_WHATSAPP_FROM — it's a Messaging Service SID (Twilio Console
# -> Messaging -> Services -> create one, add an SMS-capable number to it),
# not a phone number.
TWILIO_MESSAGE_SERVICE_SID="MGxxxx"

# ---------------------------------------------------------------------------
# Cron (Vercel Cron -> /api/cron/cancel-stale-orders)
# ---------------------------------------------------------------------------
# Any random string — Vercel automatically sends it as a Bearer token when
# it triggers the cron; set the same value in the Vercel project settings.
CRON_SECRET="a-long-random-string"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Shree Meenakshi Sweets & Savouries"
